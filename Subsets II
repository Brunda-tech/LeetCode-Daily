class Solution {
    public List<List<Integer>> subsetsWithDup(int[] nums) {
        List<List<Integer>> ans=new ArrayList<>();
        HashSet<List<Integer>> result=new HashSet<>();
        Arrays.sort(nums);

        int n=nums.length;
        for(int mask=0;mask<(1<<n);mask++){
            ArrayList<Integer> subs=new ArrayList<>();
            for(int i=0;i<n;i++){
                if((mask&(1<<i))!=0){
                subs.add(nums[i]);
            }
            }
            result.add(subs);
        }
            ans.addAll(result);
        
        return ans;
    }
}
