class Solution {
    public int removeDuplicates(int[] nums) {
        int count=0;
        HashSet<Integer>map=new HashSet<>();
        for(int i=0;i<nums.length;i++){
              if(map.add(nums[i])){
                nums[count]=nums[i];
                count++;
              }
             
        }
        return count;
        
    }
}
