class Solution {
    public int maxArea(int[] height) {
        int maxArea=0;
        int n=height.length;
        int left=0;
        int right=n-1;
        while(left<right){
            int width=right-left;
            int Height=Math.min(height[left],height[right]);
            int Area=width*Height;
            if(Area>maxArea){
                maxArea=Area;
            }
            if(height[left]<height[right]){
                left++;
            } else{
                right--;
            }

        }
        return maxArea;
    }
}
