class Solution {
    public List<Integer> addToArrayForm(int[] num, int k) {

        ArrayList<Integer> result=new ArrayList<>();
        int i=num.length-1;
        while( i>=0 || k>0){
            int value=k;

        if(i>=0){
             value+=num[i];
        }
            result.add(value%10);
            k=value/10;
            i--;
        
        }
        Collections.reverse(result);
        return result;
        
    }
}
