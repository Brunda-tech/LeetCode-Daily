class Solution {
    public long maximumTripletValue(int[] nums) {

        long maxLeft=0;
        long maxDiff=0;
        long ans=0;
        for(int num:nums){
            ans=Math.max(ans,maxDiff*num);
            maxDiff=Math.max(maxDiff,maxLeft-num);
            maxLeft=Math.max(maxLeft,num);
        }
        return ans;
        
    }
}
