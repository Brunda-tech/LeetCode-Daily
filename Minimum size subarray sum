class Solution {
    public int minSubArrayLen(int target, int[] nums) {
       int left=0;
       int sum=0;
       int minleft=Integer.MAX_VALUE;
       for(int i=0;i<nums.length;i++){
        sum+=nums[i];
        while(sum>=target){
            minleft=Math.min(minleft,i-left+1);
            sum-=nums[left];
            left++;
        }
       }
       return minleft==Integer.MAX_VALUE?0:minleft;

        
    }
}
